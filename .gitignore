# ===========================================================================
#  PERSONAL DATA / SECRETS: never commit these
#  The app keeps your login tokens, speaker IP and settings in %APPDATA%\BoseSoundbarRemote (outside this folder).
#  These rules are a safety net in case any of it ever lands inside the project folder.
# ===========================================================================
bose_config.json
**/bose_config.json
*.local
.privacy-deny.local
.env
.env.*
!.env.example
*token*.json
*credential*
*secret*
!tests/**/*secret*
*.pem
*.key
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*

# logs (they contain IP addresses, speaker names and account names)
*.log
*.log.*
logs/
log/
test_progress.*

# shortcuts and installers made on your machine (the .lnk files embed your username and paths)
*.lnk
*.url

# screenshots and recordings of your own screen (can show names, accounts, emails)
screenshots/
screenshot*/
Screenshot*
Screen Shot*
*.mp4
*.mov
*.gif
!assets/**/*.gif

# local scratch space and personal notes
local/
scratch/
tmp/
temp/
notes/
private/
*.bak
*.orig
*.rej

# editor, assistant and OS state (often contains absolute paths with your user name)
.vscode/
.idea/
.vs/
*.code-workspace
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ===========================================================================
#  Build and test output
# ===========================================================================
.venv/
venv/
env/
build/
dist/
dist-installer/
release/
__pycache__/
*.py[cod]
*.spec
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
test-results.xml
htmlcov/
