#!/bin/sh
# Blocks commits that contain personal data. Enable once per clone with:  git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
if [ -x "$root/.venv/Scripts/python.exe" ]; then PY="$root/.venv/Scripts/python.exe"
elif command -v python >/dev/null 2>&1; then PY=python
elif command -v py >/dev/null 2>&1; then PY=py
else echo "privacy check skipped: Python not found"; exit 0; fi
"$PY" "$root/scripts/check_privacy.py" --staged || {
  echo
  echo "Commit blocked by the privacy check. (Bypass only if you are sure: git commit --no-verify)"
  exit 1
}
